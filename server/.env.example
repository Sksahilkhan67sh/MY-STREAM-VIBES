# ============================================================
# StreamVault — Server Environment Variables
# Copy this to .env for local dev, set these in Render for prod
# ============================================================

# ── Server ──────────────────────────────────────────────────
PORT=4000
NODE_ENV=production
CLIENT_URL=https://your-app.vercel.app

# ── Database (PostgreSQL required for production) ────────────
# Get a free DB from: https://neon.tech or https://supabase.com
DATABASE_URL="postgresql://user:password@host:5432/streamvault?sslmode=require"

# ── Redis (optional but recommended) ────────────────────────
# Get a free Redis from: https://upstash.com  (use the rediss:// TLS URL)
# If not set, viewer counts are disabled but everything else works
REDIS_URL=rediss://default:your-password@your-host.upstash.io:6379

# ── LiveKit ──────────────────────────────────────────────────
# Get from: https://cloud.livekit.io
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# ── S3 Storage for Recordings (optional) ────────────────────
# Without S3, recordings are stored in /tmp and lost on redeploy
# AWS S3: leave S3_ENDPOINT empty
# Cloudflare R2 (free 10GB): S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# Backblaze B2: S3_ENDPOINT=https://s3.<region>.backblazeb2.com
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_ENDPOINT=

# ── Email Reminders (optional) ───────────────────────────────
# Get from: https://resend.com (free 3,000 emails/month)
RESEND_API_KEY=

# ── SMS Reminders (optional) ─────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
