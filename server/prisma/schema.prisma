generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── User ─────────────────────────────────────────────────────────────────────
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  streams          Stream[]
  subscription     Subscription?
  rtmpDestinations RtmpDestination[]
  donationConfig   DonationConfig?   // ← was missing
  usageRecords     UsageRecord[]     // ← was missing
  invoices         Invoice[]         // ← was missing
}

// ─── Plan ─────────────────────────────────────────────────────────────────────
// FIXED: added proper id field (service calls findUnique by id),
//        isActive, gateway price IDs (service reads these)
model Plan {
  id          String  @id @default(cuid())
  name        String  @unique        // 'free' | 'starter' | 'pro' | 'enterprise'
  displayName String
  description String
  isActive    Boolean @default(true) // ← was missing

  priceMonthlyINR Int
  priceYearlyINR  Int
  priceMonthlyUSD Int
  priceYearlyUSD  Int

  maxStreamsPerMonth  Int
  maxViewersPerStream Int
  maxStreamDuration   Int
  maxStorageGB        Int
  maxCoHosts          Int
  canRecord           Boolean
  canGoRTMP           Boolean
  canRunPolls         Boolean
  canAccessAnalytics  Boolean
  canAcceptDonations  Boolean
  canCustomBranding   Boolean
  canScheduleStreams  Boolean
  hasAIFeatures       Boolean
  hasPrioritySupport  Boolean
  hasWhiteLabel       Boolean
  sortOrder           Int

  // Gateway price / plan IDs — ← were all missing
  stripeMonthlyPriceId  String?
  stripeYearlyPriceId   String?
  razorpayMonthlyPlanId String?
  razorpayYearlyPlanId  String?

  subscriptions Subscription[]
}

// ─── Subscription ─────────────────────────────────────────────────────────────
// FIXED: added billingCycle, gateway, gatewayCustomerId,
//        currentPeriodEnd, cancelAtPeriodEnd, planId FK (service uses planId not planName)
model Subscription {
  id                    String    @id @default(cuid())
  userId                String    @unique
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId                String    // ← service creates with planId
  plan                  Plan      @relation(fields: [planId], references: [id])
  planName              String    // denormalised copy for fast reads
  status                String    @default("active")
  billingCycle          String    @default("monthly") // ← was missing
  gateway               String    @default("stripe")  // ← was missing
  gatewaySubscriptionId String?   @unique
  gatewayCustomerId     String?                       // ← was missing
  currentPeriodEnd      DateTime?                     // ← was missing
  currentPeriodStart    DateTime?                     // ← was missing
  trialEndsAt           DateTime?                     // ← was missing
  cancelAtPeriodEnd     Boolean   @default(false)     // ← was missing
  canceledAt            DateTime?
  currency              String    @default("usd")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  invoices Invoice[]
}

// ─── UsageRecord ──────────────────────────────────────────────────────────────
// ← entire model was missing
model UsageRecord {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  month          String   // YYYY-MM
  streamsUsed    Int      @default(0)
  storageUsedGB  Float    @default(0)
  streamMinutes  Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, month], name: "userId_month")
  @@index([userId])
}

// ─── Invoice ──────────────────────────────────────────────────────────────────
// ← entire model was missing
model Invoice {
  id                 String        @id @default(cuid())
  userId             String
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptionId     String?
  subscription       Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  planName           String
  amount             Int
  currency           String        @default("INR")
  status             String        @default("pending") // pending | paid | failed | refunded
  billingCycle       String
  gateway            String?
  gatewayInvoiceId   String?       @unique
  gatewayPaymentId   String?
  invoiceUrl         String?
  pdfUrl             String?
  billingPeriodStart DateTime?
  billingPeriodEnd   DateTime?
  paidAt             DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([userId])
}

// ─── Stream ───────────────────────────────────────────────────────────────────
// FIXED: added isPPV, plus all missing relations
model Stream {
  id           String    @id @default(cuid())
  userId       String?
  user         User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  roomId       String    @unique
  title        String
  hostToken    String
  passwordHash String?
  isLive       Boolean   @default(false)
  isRecording  Boolean   @default(false)
  recordingUrl String?
  rtmpUrl      String?
  viewerCount  Int       @default(0)
  isPPV        Boolean   @default(false) // ← was missing
  scheduledAt  DateTime?
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  recordings          Recording[]
  polls               Poll[]
  coHosts             CoHost[]
  reminders           Reminder[]
  multiStreamSessions MultiStreamSession[]
  analyticsEvents     AnalyticsEvent[]         // ← was missing
  viewerSnapshots     ConcurrentViewerSnapshot[] // ← was missing
  analytics           StreamAnalytics?         // ← was missing
  donations           Donation[]               // ← was missing
  leaderboard         DonationLeaderboard?     // ← was missing
  ticketTiers         TicketTier[]             // ← was missing
  tickets             Ticket[]                 // ← direct relation for include: { stream }
  ppvConfig           PPVConfig?               // ← was missing
  transcript          Transcript?              // ← was missing (singular — streamId is @unique)

  @@index([userId])
}

// ─── Recording ────────────────────────────────────────────────────────────────
model Recording {
  id          String    @id @default(cuid())
  streamId    String
  stream      Stream    @relation(fields: [streamId], references: [id], onDelete: Cascade)
  fileName    String
  filePath    String
  fileSize    Int       @default(0)
  durationSec Int?
  startedAt   DateTime
  endedAt     DateTime?
  createdAt   DateTime  @default(now())

  @@index([streamId])
}

// ─── Poll ─────────────────────────────────────────────────────────────────────
// FIXED: added endsAt field
model Poll {
  id        String    @id @default(cuid())
  streamId  String
  stream    Stream    @relation(fields: [streamId], references: [id], onDelete: Cascade)
  question  String
  options   String
  votes     String
  status    String    @default("active")
  endsAt    DateTime?                   // ← was missing
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  pollVotes PollVote[]

  @@index([streamId])
}

model PollVote {
  id          String   @id @default(cuid())
  pollId      String
  poll        Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)
  voterId     String
  optionIndex Int
  createdAt   DateTime @default(now())

  @@unique([pollId, voterId])
  @@index([pollId])
}

// ─── CoHost ───────────────────────────────────────────────────────────────────
// FIXED: added isActive field
model CoHost {
  id          String    @id @default(cuid())
  streamId    String
  stream      Stream    @relation(fields: [streamId], references: [id], onDelete: Cascade)
  name        String
  coHostToken String    @unique
  joinUrl     String
  isActive    Boolean   @default(true) // ← was missing
  joinedAt    DateTime?
  createdAt   DateTime  @default(now())

  @@index([streamId])
}

// ─── Reminder ─────────────────────────────────────────────────────────────────
model Reminder {
  id        String   @id @default(cuid())
  streamId  String
  stream    Stream   @relation(fields: [streamId], references: [id], onDelete: Cascade)
  type      String
  contact   String
  sent      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([streamId])
}

// ─── Analytics ────────────────────────────────────────────────────────────────
// ← all three models were missing

model AnalyticsEvent {
  id           String   @id @default(cuid())
  streamId     String
  stream       Stream   @relation(fields: [streamId], references: [id], onDelete: Cascade)
  event        String   // join | leave | chat | reaction | poll_vote | donate
  viewerId     String?
  sessionId    String?
  watchSeconds Int      @default(0)
  deviceType   String?
  browser      String?
  os           String?
  country      String?
  region       String?
  city         String?
  userId       String?
  timestamp    DateTime @default(now())

  @@index([streamId])
  @@index([streamId, event])
}

model ConcurrentViewerSnapshot {
  id        String   @id @default(cuid())
  streamId  String
  stream    Stream   @relation(fields: [streamId], references: [id], onDelete: Cascade)
  count     Int
  timestamp DateTime @default(now())

  @@index([streamId])
  @@index([streamId, timestamp])
}

model StreamAnalytics {
  id                 String   @id @default(cuid())
  streamId           String   @unique
  stream             Stream   @relation(fields: [streamId], references: [id], onDelete: Cascade)
  totalJoins         Int      @default(0)
  uniqueViewers      Int      @default(0)
  peakConcurrent     Int      @default(0)
  totalWatchSeconds  BigInt   @default(0)
  avgWatchSeconds    Int      @default(0)
  totalChatMessages  Int      @default(0)
  totalReactions     Int      @default(0)
  totalPollVotes     Int      @default(0)
  chatEngagementRate Float    @default(0)
  deviceBreakdown    Json     @default("{}")
  countryBreakdown   Json     @default("{}")
  browserBreakdown   Json     @default("{}")
  retentionCurve     Json     @default("[]")
  concurrentTimeline Json     @default("[]")
  durationSeconds    Int      @default(0)
  endedAt            DateTime?
  updatedAt          DateTime @updatedAt
}

// ─── Captions / Transcripts ───────────────────────────────────────────────────
// ← both models were missing

model Transcript {
  id          String    @id @default(cuid())
  streamId    String    @unique
  stream      Stream    @relation(fields: [streamId], references: [id], onDelete: Cascade)
  language    String    @default("en")
  provider    String    @default("deepgram")
  status      String    @default("active")   // active | completed | error
  fullText    String    @default("")
  startedAt   DateTime?
  completedAt DateTime?
  errorMsg    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  segments TranscriptSegment[]

  @@index([streamId])
}

model TranscriptSegment {
  id           String     @id @default(cuid())
  transcriptId String
  transcript   Transcript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)
  text         String
  startMs      Int
  endMs        Int
  confidence   Float      @default(1.0)
  language     String     @default("en")
  speaker      String?
  isFinal      Boolean    @default(true)
  createdAt    DateTime   @default(now())

  @@index([transcriptId])
}

// ─── Donations ────────────────────────────────────────────────────────────────
// ← all three models were missing

model DonationConfig {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  razorpayKeyId        String?
  razorpayKeySecret    String?
  stripePublishableKey String?
  stripeSecretKey      String?
  stripeWebhookSecret  String?
  upiId                String?
  upiName              String?
  minimumAmount        Int      @default(100)
  currency             String   @default("INR")
  alertDuration        Int      @default(10)
  alertSound           Boolean  @default(true)
  thankYouMessage      String   @default("Thank you for your support!")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Donation {
  id               String    @id @default(cuid())
  streamId         String
  stream           Stream    @relation(fields: [streamId], references: [id], onDelete: Cascade)
  donorName        String
  donorEmail       String?
  message          String?
  amount           Int
  displayAmount    Float     @default(0)   // human-readable (amount / 100)
  currency         String    @default("INR")
  gateway          String    // razorpay | stripe | upi
  status           String    @default("pending") // pending | paid | failed | refunded
  gatewayOrderId   String?
  gatewayPaymentId String?
  isAnonymous      Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([streamId])
}

model DonationLeaderboard {
  id        String   @id @default(cuid())
  streamId  String   @unique
  stream    Stream   @relation(fields: [streamId], references: [id], onDelete: Cascade)
  entries   Json     @default("[]")
  updatedAt DateTime @updatedAt
}

// ─── Pay-Per-View ─────────────────────────────────────────────────────────────
// ← all three models were missing

model PPVConfig {
  id                 String   @id @default(cuid())
  streamId           String   @unique
  stream             Stream   @relation(fields: [streamId], references: [id], onDelete: Cascade)
  isEnabled          Boolean  @default(true)
  allowRefunds       Boolean  @default(false)
  refundWindowHours  Int      @default(24)
  maxTicketsPerBuyer Int      @default(5)
  thankYouMessage    String   @default("Thank you for your purchase!")
  reminderEnabled    Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model TicketTier {
  id          String   @id @default(cuid())
  streamId    String
  stream      Stream   @relation(fields: [streamId], references: [id], onDelete: Cascade)
  name        String
  description String?
  price       Int                      // stored in smallest unit (paise / cents)
  currency    String   @default("INR")
  maxQuantity Int?
  soldCount   Int      @default(0)
  revenue     Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tickets Ticket[]

  @@index([streamId])
}

model Ticket {
  id                String     @id @default(cuid())
  tierId            String
  tier              TicketTier @relation(fields: [tierId], references: [id], onDelete: Cascade)
  streamId          String
  stream            Stream     @relation(fields: [streamId], references: [id], onDelete: Cascade)
  buyerName         String
  buyerEmail        String
  amount            Int
  currency          String
  gateway           String
  status            String     @default("pending") // pending | paid | active | refunded | canceled
  gatewayOrderId    String?
  gatewayPaymentId  String?
  gatewaySignature  String?
  ticketCode        String     @unique @default(cuid())
  accessToken       String?
  expiresAt         DateTime?
  accessedAt        DateTime?
  paidAt            DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([tierId])
  @@index([streamId])
  @@index([accessToken])
}

// ─── RTMP Multi-stream ────────────────────────────────────────────────────────
model RtmpDestination {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform     String
  label        String
  rtmpUrl      String
  streamKey    String
  isEnabled    Boolean   @default(true)
  totalStreams  Int       @default(0)
  totalMinutes Int       @default(0)
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  streamSessions MultiStreamSession[]

  @@index([userId])
}

model MultiStreamSession {
  id            String          @id @default(cuid())
  streamId      String
  stream        Stream          @relation(fields: [streamId], references: [id], onDelete: Cascade)
  destinationId String
  destination   RtmpDestination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  status        String          @default("idle")
  startedAt     DateTime?
  stoppedAt     DateTime?
  errorMessage  String?
  bitrateKbps   Int             @default(0)
  droppedFrames Int             @default(0)
  latencyMs     Int             @default(0)
  health        String          @default("unknown")
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([streamId])
  @@index([destinationId])
}
