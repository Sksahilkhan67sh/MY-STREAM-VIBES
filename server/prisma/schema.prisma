generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Stream {
  id           String    @id @default(cuid())
  roomId       String    @unique
  title        String
  hostToken    String    @unique
  passwordHash String?
  isLive       Boolean   @default(false)
  isRecording  Boolean   @default(false)
  scheduledAt  DateTime?
  expiresAt    DateTime
  viewerCount  Int       @default(0)
  recordingUrl String?
  rtmpUrl      String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  userId       String?
  user         User?     @relation("UserStreams", fields: [userId], references: [id], onDelete: SetNull)

  reminders        Reminder[]
  recordings       Recording[]
  polls            Poll[]
  coHosts          CoHost[]
  analyticsEvents  AnalyticsEvent[]
  analytics        StreamAnalytics?
  concurrentSnaps  ConcurrentViewerSnapshot[]

  @@index([userId])
}

model CoHost {
  id          String   @id @default(cuid())
  streamId    String
  stream      Stream   @relation(fields: [streamId], references: [id], onDelete: Cascade)
  name        String
  coHostToken String   @unique
  joinUrl     String
  isActive    Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Reminder {
  id        String   @id @default(cuid())
  streamId  String
  stream    Stream   @relation(fields: [streamId], references: [id], onDelete: Cascade)
  type      String
  contact   String
  sent      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Recording {
  id          String    @id @default(cuid())
  streamId    String
  stream      Stream    @relation(fields: [streamId], references: [id], onDelete: Cascade)
  fileName    String
  filePath    String
  fileSize    Int       @default(0)
  durationSec Int       @default(0)
  startedAt   DateTime
  endedAt     DateTime?
  createdAt   DateTime  @default(now())
}

model Poll {
  id        String     @id @default(cuid())
  streamId  String
  stream    Stream     @relation(fields: [streamId], references: [id], onDelete: Cascade)
  question  String
  options   String
  votes     String
  status    String     @default("active")
  endsAt    DateTime?
  createdAt DateTime   @default(now())

  pollVotes PollVote[]
}

model PollVote {
  id          String   @id @default(cuid())
  pollId      String
  poll        Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)
  voterId     String
  optionIndex Int
  createdAt   DateTime @default(now())

  @@unique([pollId, voterId])
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  image         String?
  provider      String   @default("github")
  providerId    String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  streams         Stream[]         @relation("UserStreams")
  analyticsEvents AnalyticsEvent[]

  @@unique([provider, providerId])
  @@index([email])
}

model AnalyticsEvent {
  id         String   @id @default(cuid())
  streamId   String
  stream     Stream   @relation(fields: [streamId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  event        String
  viewerId     String
  sessionId    String

  deviceType   String?
  browser      String?
  os           String?
  country      String?
  region       String?
  city         String?

  watchSeconds Int      @default(0)
  timestamp    DateTime @default(now())

  @@index([streamId])
  @@index([viewerId])
  @@index([timestamp])
  @@index([event])
}

model StreamAnalytics {
  id                    String   @id @default(cuid())
  streamId              String   @unique
  stream                Stream   @relation(fields: [streamId], references: [id], onDelete: Cascade)

  totalJoins            Int      @default(0)
  uniqueViewers         Int      @default(0)
  peakConcurrent        Int      @default(0)
  totalWatchSeconds     BigInt   @default(0)
  avgWatchSeconds       Int      @default(0)

  totalChatMessages     Int      @default(0)
  totalReactions        Int      @default(0)
  totalPollVotes        Int      @default(0)
  chatEngagementRate    Float    @default(0)

  deviceBreakdown       Json     @default("{}")
  browserBreakdown      Json     @default("{}")
  countryBreakdown      Json     @default("{}")

  retentionCurve        Json     @default("[]")
  concurrentTimeline    Json     @default("[]")

  durationSeconds       Int      @default(0)
  startedAt             DateTime?
  endedAt               DateTime?

  updatedAt             DateTime @updatedAt
  createdAt             DateTime @default(now())
}

model ConcurrentViewerSnapshot {
  id        String   @id @default(cuid())
  streamId  String
  stream    Stream   @relation(fields: [streamId], references: [id], onDelete: Cascade)
  count     Int
  timestamp DateTime @default(now())

  @@index([streamId, timestamp])
}