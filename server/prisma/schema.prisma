generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════════════════
// PHASE 5: MULTI-PLATFORM STREAMING (Restream-like)
// ADD THESE MODELS TO server/prisma/schema.prisma
// Run: npx prisma migrate dev --name phase5_multistream
// ═══════════════════════════════════════════════════════════════════════════

/// One saved RTMP destination belonging to a user
model RtmpDestination {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  platform    String   // youtube | twitch | facebook | linkedin | custom
  label       String   // user-defined nickname e.g. "My YouTube Gaming"
  rtmpUrl     String   // full rtmp://... url  (base + key merged)
  streamKey   String   // stored separately for display masking
  isEnabled   Boolean  @default(true)

  // Stats rollup
  totalStreams Int      @default(0)
  totalMinutes Int     @default(0)
  lastUsedAt   DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  streamSessions MultiStreamSession[]

  @@index([userId])
}

/// One multistream session — a stream pushed to multiple destinations simultaneously
model MultiStreamSession {
  id            String   @id @default(cuid())
  streamId      String
  stream        Stream   @relation(fields: [streamId], references: [id], onDelete: Cascade)
  destinationId String
  destination   RtmpDestination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  status        String   @default("idle")
  // idle | connecting | live | error | stopped

  startedAt     DateTime?
  stoppedAt     DateTime?
  errorMessage  String?

  // Health metrics (updated every 30s)
  bitrateKbps   Int      @default(0)
  droppedFrames Int      @default(0)
  latencyMs     Int      @default(0)
  health        String   @default("unknown") // good | degraded | poor | unknown

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([streamId])
  @@index([destinationId])
}

