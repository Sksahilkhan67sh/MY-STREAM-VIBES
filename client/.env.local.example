# ============================================================
# StreamVault — Client Environment Variables
# Set ALL of these in your Vercel project → Settings → Env Vars
# ============================================================

# Your Render backend URL (no trailing slash)
NEXT_PUBLIC_API_URL=https://your-backend.onrender.com

# Your Vercel frontend URL
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# LiveKit cloud URL (same value as server LIVEKIT_URL)
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud

# Host authentication PIN (required to access /host dashboard)
# Change this to a strong PIN before deploying!
# Default fallback is "stream" if not set (change it!)
NEXT_PUBLIC_HOST_PIN=your-secret-pin-here
